# Supabase (leave empty to run local demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Force demo mode even if Supabase keys exist (optional)
# DEMO_MODE=true

# OpenAI (optional — falls back to deterministic Slovak templates)
OPENAI_API_KEY=

# Resend (optional — notifications logged as failed without key)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@movequote.sk

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MoveQuote

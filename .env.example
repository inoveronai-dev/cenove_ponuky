# Supabase (leave empty to run local demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Force demo mode even if Supabase keys exist (optional)
# DEMO_MODE=true

# OpenAI (required for AI text + microphone transcription on Vercel too)
# Set the same key in Vercel → Project → Settings → Environment Variables
OPENAI_API_KEY=

# Resend (optional — notifications logged as failed without key)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@toptn.sk

# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_NAME=Cenové ponuky
